<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PromptAdvisor</AssemblyName>
    <RootNamespace>PromptAdvisor</RootNamespace>
    <!-- ThemeMode(.NET 9 실험 API) 경고 억제 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <!-- Velopack 이 Main 보다 먼저 돌아야 하므로 Program.Main 을 직접 쓴다 -->
    <StartupObject>PromptAdvisor.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- 셀프테스트가 XAML 한글 문자열의 영어 번역 누락을 확인하려고 원본을 함께 넣는다 -->
    <EmbeddedResource Include="MainWindow.xaml" LogicalName="xaml-source" />
    <None Include="models.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
